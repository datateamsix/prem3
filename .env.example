# Copy to .env for local development. Do not commit .env.
# Local ADK uses Application Default Credentials, not a service-account key:
#   %APPDATA%\gcloud\application_default_credentials.json
# Do not set GOOGLE_APPLICATION_CREDENTIALS or GOOGLE_API_KEY.
# Cloud Run will use M3_RUNTIME_SA instead of your user ADC.

# Google Cloud
GOOGLE_CLOUD_PROJECT=modelready-m3
GOOGLE_CLOUD_PROJECT_NUMBER=912257136465
# Vertex Gemini endpoint (global reduces 429 capacity contention)
GOOGLE_CLOUD_LOCATION=global
# Buckets, BigQuery datasets, Cloud Run, and Firestore stay regional
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Runtime identity — Cloud Run attaches this service account. Do not deploy as a human Owner.
M3_RUNTIME_SA=m3-runtime@modelready-m3.iam.gserviceaccount.com
MODELREADY_CLOUD_RUN_SERVICE=modelready-m3

# Gemini / ADK — Vertex publisher IDs only (not AI Studio aliases)
M3_GEMINI_MODEL=gemini-2.5-flash
M3_AGENT_NAME=modelready_m3

# MODELREADY_ORGANIZATION_ID / MODELREADY_WORKSPACE_ID are developer/CLI
# bootstrap inputs only (app.core.developer_bootstrap). They are not Settings
# authority and do not bind require_tenant() / require_workspace().
MODELREADY_ORGANIZATION_ID=music-center
MODELREADY_WORKSPACE_ID=mmm-demo

# Storage — uniform bucket-level access in us-central1
# RAW: immutable incoming packages
# ARTIFACTS: normalized data, reports, manifests, provenance, receipts
MODELREADY_RAW_BUCKET=modelready-m3-912257136465-raw
MODELREADY_ARTIFACT_BUCKET=modelready-m3-912257136465-artifacts

# BigQuery — dataset IDs, not fully-qualified table names
MODELREADY_BQ_OPS_DATASET=modelready_ops
MODELREADY_BQ_EXPERIENCE_DATASET=modelready_experience
MODELREADY_BQ_MODELS_DATASET=modelready_models

# Firestore — Mission 2 operational control plane (Native, us-central1).
# Uses GOOGLE_CLOUD_PROJECT above. Do not put tenant, Clerk, or Stripe IDs here.
# Leave FIRESTORE_EMULATOR_HOST unset unless you are running the emulator.
FIRESTORE_DATABASE=(default)

# prem3-api factory. Unset / local = in-memory control plane.
# Cloud Run sets K_SERVICE and the image sets PREM3_API_RUNTIME=cloud.
# PREM3_API_RUNTIME=local

# Runtime
MODELREADY_ENV=dev
MODELREADY_LOG_LEVEL=INFO

# Isolated Meridian EDA Cloud Run Job (not installed in the ADK service image)
MODELREADY_EDA_JOB=meridian-eda-worker
MODELREADY_EDA_JOB_TIMEOUT=3300

# Versioned DOMAIN_VIEW registry (GCS). Unset = bootstrap v1.0.0 in the image.
# MODELREADY_DOMAIN_VIEW_REGISTRY_GS_URI=gs://modelready-m3-912257136465-artifacts/experiments/cloud_first_learning_cycle_001/domain_view_registry/

# Clerk — server-only. Never NEXT_PUBLIC_* for these values.
# Unset = prem3-api fail-closed with AUTH_PROVIDER_NOT_CONFIGURED.
# CLERK_SECRET_KEY=sk_test_replace_me
# CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# CLERK_JWT_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_API_TIMEOUT_SECONDS=5

# Stripe — server-only. Never NEXT_PUBLIC_* for these values.
# Unset = prem3-api fail-closed with BILLING_PROVIDER_NOT_CONFIGURED.
# Use test-mode keys only in local qualification. Do not commit real secrets or Price IDs.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_PROJECT=price_replace_me_project
# STRIPE_PRICE_PORTFOLIO=price_replace_me_portfolio
# STRIPE_PRICE_ENTERPRISE=price_replace_me_enterprise
# Optional catalog presentation. Unset = no invented display prices.
# STRIPE_CATALOG_CURRENCY=usd
# STRIPE_CATALOG_PROJECT_AMOUNT=9900
# STRIPE_CATALOG_PORTFOLIO_AMOUNT=24900
# STRIPE_CATALOG_ENTERPRISE_AMOUNT=99900
# STRIPE_CATALOG_PROJECT_DISPLAY_PRICE=$99/mo
# STRIPE_CATALOG_PORTFOLIO_DISPLAY_PRICE=$249/mo
# STRIPE_CATALOG_ENTERPRISE_DISPLAY_PRICE=$999/mo
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
# PREM3_FRONTEND_ORIGIN=http://localhost:3000
# STRIPE_TIMEOUT_SECONDS=10
# STRIPE_MAX_NETWORK_RETRIES=2
# WEBHOOK_CLAIM_LEASE_SECONDS=120

# Google OAuth — server-only. Never NEXT_PUBLIC_* for these values.
# Unset = Google OAuth start fails closed with GOOGLE_OAUTH_NOT_CONFIGURED.
# Callback URI must match the registered Google Cloud OAuth client exactly.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/integrations/google/oauth/callback
# GOOGLE_CREDENTIAL_VAULT_KEY=
# GOOGLE_KMS_KEY=
# GOOGLE_OAUTH_TTL_SECONDS=600

# Durable Evaluation dispatch (M2-13). Unset locally = Fake dispatcher.
# Cloud runtime without these four values fail-closes enqueue.
# EVALUATION_DISPATCH_QUEUE=prem3-evaluation-dispatch
# EVALUATION_WORKER_JOB=prem3-evaluation-worker
# EVALUATION_DISPATCHER_SA=prem3-evaluation-dispatcher@modelready-m3.iam.gserviceaccount.com
# EVALUATION_LAUNCH_URL=https://prem3-api-vkcd3cbiea-uc.a.run.app/internal/v1/evaluation-dispatches
# EVALUATION_LAUNCH_AUDIENCE=https://prem3-api-vkcd3cbiea-uc.a.run.app/internal/v1/evaluation-dispatches
