  generated_at TIMESTAMP NOT NULL
)
PARTITION BY DATE(generated_at)
CLUSTER BY run_id, channel_id;

CREATE TABLE IF NOT EXISTS `{{ project_id }}.{{ modeling_dataset }}.mta_model_sensitivity` (
