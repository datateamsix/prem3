CREATE TABLE IF NOT EXISTS `{{ project_id }}.{{ modeling_dataset }}.mta_result_snapshots` (
  result_snapshot_id STRING NOT NULL,
  run_id STRING NOT NULL,
  execution_plan_id STRING NOT NULL,
  run_receipt_id STRING NOT NULL,
  result_status STRING NOT NULL,
  evidence_authority STRING NOT NULL,
  fingerprint STRING NOT NULL,
  generated_at TIMESTAMP NOT NULL
)
PARTITION BY DATE(generated_at)
CLUSTER BY run_id;

CREATE TABLE IF NOT EXISTS `{{ project_id }}.{{ modeling_dataset }}.mta_channel_results` (
  result_snapshot_id STRING NOT NULL,
  run_id STRING NOT NULL,
  channel_id STRING NOT NULL,
  channel_display_name STRING,
  journey_presence_rate FLOAT64,
  first_position_share FLOAT64,
  middle_position_share FLOAT64,
  last_position_share FLOAT64,
  generated_at TIMESTAMP NOT NULL
)
PARTITION BY DATE(generated_at)
CLUSTER BY run_id, channel_id;

CREATE TABLE IF NOT EXISTS `{{ project_id }}.{{ modeling_dataset }}.mta_model_comparison` (
  result_snapshot_id STRING NOT NULL,
  run_id STRING NOT NULL,
  channel_id STRING NOT NULL,
  model_type STRING NOT NULL,
  attribution_share FLOAT64,
  attributed_credit FLOAT64,
  generated_at TIMESTAMP NOT NULL
)
PARTITION BY DATE(generated_at)
CLUSTER BY run_id, model_type, channel_id;

CREATE TABLE IF NOT EXISTS `{{ project_id }}.{{ modeling_dataset }}.mta_channel_position_evidence` (
  result_snapshot_id STRING NOT NULL,
  run_id STRING NOT NULL,
  channel_id STRING NOT NULL,
  first_position_count INT64 NOT NULL,
  middle_position_count INT64 NOT NULL,
  last_position_count INT64 NOT NULL,
  first_position_share FLOAT64 NOT NULL,
  middle_position_share FLOAT64 NOT NULL,
  last_position_share FLOAT64 NOT NULL,
  journey_presence_count INT64 NOT NULL,
  journey_presence_rate FLOAT64 NOT NULL,
