-- IG-04 unified sessions. Property-scoped session key. Settled daily shards only.
-- user_pseudo_id / user_id may exist only as BQ analytical keys, never Firestore/API.
WITH e AS (
  SELECT
    event_date,
    event_timestamp,
    user_pseudo_id,
    user_id,
    '{{ ga4_property_id }}' AS ga4_property_id,
    '{{ ga4_source_binding_id }}' AS ga4_source_binding_id,
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key='ga_session_id') AS ga_session_id,
    COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.source,
      session_traffic_source_last_click.manual_campaign.source,
      collected_traffic_source.manual_source
    ) AS source,
    COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.medium,
      session_traffic_source_last_click.manual_campaign.medium,
      collected_traffic_source.manual_medium
    ) AS medium,
    COALESCE(
      session_traffic_source_last_click.cross_channel_campaign.campaign_name,
      session_traffic_source_last_click.manual_campaign.campaign_name,
      collected_traffic_source.manual_campaign_name
    ) AS campaign,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key='utm_id') AS utm_id
  FROM `{{ ga4_project_id }}.{{ ga4_dataset_id }}.events_*`
  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', @source_start_date)
                          AND FORMAT_DATE('%Y%m%d', @source_end_date)
    AND _TABLE_SUFFIX NOT LIKE 'intraday%'
),
x AS (
  SELECT
    TO_HEX(SHA256(CONCAT(
      ga4_property_id, '|',
      CASE '{{ identity_strategy }}'
        WHEN 'USER_ID_ONLY' THEN COALESCE(user_id,'')
        WHEN 'USER_ID_PREFERRED_WITH_PSEUDO_FALLBACK' THEN COALESCE(NULLIF(user_id,''),user_pseudo_id,'')
        ELSE COALESCE(user_pseudo_id,'')
      END,
      '|', CAST(ga_session_id AS STRING)
    ))) AS session_id,
    TO_HEX(SHA256(
      CASE '{{ identity_strategy }}'
        WHEN 'USER_ID_ONLY' THEN COALESCE(user_id,'')
        WHEN 'USER_ID_PREFERRED_WITH_PSEUDO_FALLBACK' THEN COALESCE(NULLIF(user_id,''),user_pseudo_id,'')
        ELSE COALESCE(user_pseudo_id,'')
      END
    )) AS subject_key,
    ga4_property_id,
    ga4_source_binding_id,
    CAST(ga_session_id AS STRING) AS ga_session_id,
    TIMESTAMP_MICROS(event_timestamp) AS event_ts,
    source, medium, campaign, utm_id
  FROM e
  WHERE ga_session_id IS NOT NULL
)
SELECT
  session_id,
  ga4_property_id,
  ga4_source_binding_id,
  ARRAY_AGG(subject_key ORDER BY event_ts LIMIT 1)[OFFSET(0)] AS subject_key,
  ARRAY_AGG(ga_session_id ORDER BY event_ts LIMIT 1)[OFFSET(0)] AS ga_session_id,
  MIN(event_ts) AS session_start_ts,
  MAX(event_ts) AS session_end_ts,
  ARRAY_AGG(source IGNORE NULLS ORDER BY event_ts DESC LIMIT 1)[SAFE_OFFSET(0)] AS source,
  ARRAY_AGG(medium IGNORE NULLS ORDER BY event_ts DESC LIMIT 1)[SAFE_OFFSET(0)] AS medium,
  ARRAY_AGG(campaign IGNORE NULLS ORDER BY event_ts DESC LIMIT 1)[SAFE_OFFSET(0)] AS campaign_name,
  ARRAY_AGG(utm_id IGNORE NULLS ORDER BY event_ts DESC LIMIT 1)[SAFE_OFFSET(0)] AS utm_id
FROM x
GROUP BY session_id, ga4_property_id, ga4_source_binding_id
